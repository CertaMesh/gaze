+// Transport-only bridge for the current custom-policy benchmark arm. Detection
+// and action resolution remain the release's unmodified library code.
+fn build_policy_run() -> Result<(Pipeline, LocaleChain), Box<dyn std::error::Error>> {
+    let path =
+        std::env::var_os("GAZE_BENCH_POLICY").ok_or("policy-file requires GAZE_BENCH_POLICY")?;
+    let policy = gaze::Policy::load_for_cli(std::path::Path::new(&path))?;
+    let mut rulepacks = Vec::new();
+    for bundle in &policy.rulepacks.bundled {
+        rulepacks.push(load_bundled_rulepack(bundle)?);
+    }
+    for path in &policy.rulepacks.paths {
+        rulepacks.push(Rulepack::load(RulepackSource::Path(path.clone()))?);
+    }
+    let mut defaults = Vec::new();
+    for pack in &rulepacks {
+        for locale in &pack.default_locales {
+            if !defaults.contains(locale) {
+                defaults.push(locale.clone());
+            }
+        }
+    }
+    let locales = LocaleChain::merge_cli_policy_rulepack_default(
+        None,
+        policy.locale.as_deref(),
+        Some(&defaults),
+    );
+    let threshold = policy.ner.as_ref().map(|ner| ner.threshold);
+    let pipeline =
+        gaze_assembly::build_pipeline(&policy, &empty_context(), &rulepacks, &locales, threshold)?;
+    Ok((pipeline, locales))
+}
